# Konfigurasi container untuk docker-compose.dev.yml.
# Salin jadi .env.docker, lalu sesuaikan kalau port 5432 sudah dipakai.
#
# PENTING: nilai di sini harus cocok dengan DATABASE_URL di apps/backend/.env
# Kalau tidak, backend gagal ping saat startup.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=todolist_dev
POSTGRES_PORT=5432
